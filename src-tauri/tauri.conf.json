{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spot",
  "version": "1.0.2",
  "identifier": "com.jonathanpepe.spot",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spot",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.productivity",
    "shortDescription": "Spotting sessions for film sound",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "spot"
        ],
        "name": "Spot Project",
        "description": "Spot project",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}